---
// The site mark: a reliability diagram. Dashed diagonal = perfect calibration,
// accent steps = a model that stays close to it.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"></rect>
  <path d="M6 18 18 6" stroke="var(--bg)" stroke-width="1.4" stroke-dasharray="1.6 1.9" fill="none"></path>
  <path d="M6 18h3v-3.5h3V11h3V7.5h3" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
