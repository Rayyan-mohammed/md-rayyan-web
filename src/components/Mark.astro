---
// The site mark: an MR ligature. The R grows out of the M's right stroke;
// its green leg is the accent that means "the part I built" across the site.
// Fixed ink tile in both themes so the mark reads the same everywhere.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="31" height="31" rx="8" fill="#15171a" stroke="var(--rule-strong)"></rect>
  <path d="M7 23V9l5 8 5-8v14M17 9h3.5a4 4 0 0 1 0 8H17" fill="none" stroke="#f6f5f1" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M20.5 17l4.5 6" fill="none" stroke="#3dd68c" stroke-width="2.6" stroke-linecap="round"></path>
</svg>
