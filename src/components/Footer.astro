---
import Mark from './Mark.astro';
import { links, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="wordmark" href="/"><Mark class="wordmark__mark" /><span>MD Rayyan</span></a>
        <p>ML systems and the evaluations that decide whether to trust them. Final-year B.Tech CSE (Data Science), SVKM's NMIMS Hyderabad, graduating June 2027.</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <h2>This site</h2>
        <ul>
          <li><a href="/#work">Selected work</a></li>
          <li><a href="/research">Research</a></li>
          <li><a href="/work/argus">Argus case study</a></li>
          <li><a href="/work/bharathealth">BharatHealth case study</a></li>
          <li><a href="/work/obscuron">Obscuron case study</a></li>
          <li><a href={site.cv} download="MD_Rayyan_Resume.pdf">CV (PDF)</a></li>
        </ul>
      </div>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          <li><a href={links.github}>GitHub</a></li>
          <li><a href={links.linkedin}>LinkedIn</a></li>
          <li><a href={links.arxiv}>arXiv</a></li>
          <li><a href={links.credly}>Credly</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__base">
      <span>© {new Date().getFullYear()} MD Rayyan</span>
      <span><a href={links.source}>Source on GitHub</a></span>
    </div>
  </div>
</footer>
