---
import Base from './Base.astro';
import type { Link } from '../data/work';
import { site } from '../data/site';

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  description: string;
  meta: { label: string; value: string; mine?: boolean }[];
  links: Link[];
  stats: { value: string; label: string }[];
  next: { href: string; title: string };
  prev?: { href: string; title: string };
  toc: { id: string; label: string }[];
}

const { slug, title, subtitle, description, meta, links, stats, next, prev, toc } = Astro.props;
const external = (href: string) => href.startsWith('http');
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${title}: ${subtitle}`,
  description,
  author: { '@id': `${site.url}/#person` },
  url: `${site.url}/work/${slug}`,
  dateModified: site.lastUpdated,
  image: `${site.url}/og/${slug}.png`,
};
---
<Base
  title={title}
  description={description}
  image={`/og/${slug}.png`}
  imageAlt={`${title}: ${subtitle}`}
  type="article"
  jsonLd={[article]}
>
  <header class="cs-head">
    <div class="container">
      <p class="crumbs"><a href="/#work">Work</a> / {title}</p>
      <h1 class={`vt-${slug}`}>{title}</h1>
      <p class="cs-sub">{subtitle}</p>
      <dl class="cs-meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd class:list={{ mine: m.mine }}>{m.value}</dd>
          </div>
        ))}
      </dl>
      <p class="link-row">
        {links.map((l) => (
          <a href={l.href}>{l.label} <span class="arrow" aria-hidden="true">{external(l.href) ? '↗' : '→'}</span></a>
        ))}
      </p>
    </div>
  </header>
  <div class="container cs-body">
    <article class="prose">
      <div class="pull-stat">
        {stats.map((s) => (
          <div><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>
      <slot />
    </article>
    <aside class="toc" aria-label="On this page">
      <p class="toc__title">On this page</p>
      <ol>
        {toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.label}</a></li>)}
      </ol>
    </aside>
  </div>
  <script>
    // Highlight the section being read in the "On this page" list.
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    const heads = tocLinks
      .map((a) => document.getElementById(a.dataset.toc ?? ''))
      .filter((h): h is HTMLElement => Boolean(h));
    let pending = false;
    const mark = () => {
      pending = false;
      const line = window.innerHeight * 0.3;
      let active = heads[0]?.id;
      for (const h of heads) if (h.getBoundingClientRect().top <= line) active = h.id;
      for (const a of tocLinks) {
        if (a.dataset.toc === active) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (!pending) {
          pending = true;
          requestAnimationFrame(mark);
        }
      },
      { passive: true },
    );
    requestAnimationFrame(mark);
  </script>
  <div class="container">
    <nav class="cs-next" aria-label="More case studies">
      {prev ? <a href={prev.href}><span>← Previous</span><b>{prev.title}</b></a> : <a href="/#work"><span>← Back</span><b>All work</b></a>}
      <a href={next.href}><span>Next →</span><b>{next.title}</b></a>
    </nav>
  </div>
</Base>
