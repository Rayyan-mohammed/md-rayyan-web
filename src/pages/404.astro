---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist. Try the selected work or the research list.">
  <section class="container notfound">
    <p class="ruler"><b>404</b> Not found</p>
    <h1>This page doesn’t exist.</h1>
    <p>It may have moved when the site was rebuilt. The work and the papers are one click away.</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/#work">Selected work</a>
      <a class="btn" href="/research">Research</a>
      <a class="btn" href="/">Home</a>
    </div>
  </section>
</Base>
